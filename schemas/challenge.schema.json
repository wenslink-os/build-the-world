{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build The World challenge v1",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "description",
    "api",
    "spec",
    "hints",
    "exports",
    "cases",
    "prerequisites"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "api": {
      "type": "string",
      "minLength": 1
    },
    "spec": {
      "type": "string",
      "minLength": 1
    },
    "hints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "body"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      }
    },
    "starter": {
      "type": "string"
    },
    "broken": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    }
  }
}